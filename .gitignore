# Godot 4+ specific ignores
.godot/
/android/

# Exportaciones (el APK/AAB va en las releases de GitHub, no en el repo)
/build/
*.apk
*.aab
*.jks
*.keystore

# Capturas de validación generadas localmente; las pruebas las recrean.
/capturas/
# Configuración y secretos locales de firma.
.env
.env.*
*.p12
*.pfx
*.pem
*.key
contrasena*.txt
contraseña*.txt
/barrels-claves/
*.log

# Caches Python de los generadores
__pycache__/
*.py[cod]
